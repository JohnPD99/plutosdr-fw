{
  "name": "Maia SDR Dev",
  "image": "ghcr.io/maia-sdr/maia-sdr-devel:latest",
  "workspaceFolder": "/hdl",
  "mounts": [
    "source=${localWorkspaceFolder},target=/hdl,type=bind",
    "source=vivado2023_2,target=/opt/Xilinx,type=volume"
  ],
  "runArgs": [
    "--net=host",
    "--ulimit", "nofile=1024:1048576",
    "-e", "DISPLAY=${env:DISPLAY}",
    "-it"
  ],
  "settings": {
    "python.pythonPath": "/usr/bin/python3"
  },
  "remoteUser": "ubuntu",
  "env": {
    "PATH": "/opt/yosys/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
  },
  "postCreateCommand": "echo 'source /opt/Xilinx/Vivado/2023.2/settings64.sh' >> ~/.bashrc && echo 'source /opt/rust/env' >> ~/.bashrc && echo 'export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/opt/gcc-arm-linux-gnueabi/bin:$PATH:/opt/oss-cad-suite/bin' >> ~/.bashrc",
  "extensions": [
    "ms-python.python",
    "ms-vscode.cpptools"
  ]
}
